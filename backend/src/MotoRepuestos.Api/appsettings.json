{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.DataProtection": "Error"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=MotoRepuestosRest;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "MotoRepuestos.Api",
    "Audience": "MotoRepuestos.Web",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "SecureCookies": true
  },
  "RateLimiting": {
    "GlobalPermitPerMinute": 300,
    "AuthPermitPerMinute": 10,
    "WritesPermitPerMinute": 60,
    "DemoResetPermitPerMinute": 2
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "ImageStorage": {
    "RootPath": "storage/images/products",
    "MaxTotalSizeMB": 0
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Seed": {
    "Enabled": true,
    "DemoOrders": true,
    "ImagesPath": "SeedData/images",
    "DemoPassword": "Demo1234!"
  }
}
