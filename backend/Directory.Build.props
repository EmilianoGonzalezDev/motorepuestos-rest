<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1848/CA1873: LoggerMessage delegates are overkill for this sample; CA2007: ASP.NET Core has no SynchronizationContext -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2007;CA1716;CA1062;CA1515;CA1711;CA1859;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1862;CA1031;CA1724;CA2227;CA1002;CA1056;CA1054;CA1034;CA1819;CA2201;CA1720;CA1000</NoWarn>
  </PropertyGroup>
</Project>
